#!/usr/bin/env python3
import os, sys
sys.path.insert(0, os.getcwd())
from intervals import merge
def m(x):
    return [list(p) for p in merge(x)]
ok = m([[1, 3], [2, 6], [8, 10], [15, 18]]) == [[1, 6], [8, 10], [15, 18]]
ok = ok and m([[5, 7], [1, 3], [3, 4]]) == [[1, 4], [5, 7]]
ok = ok and m([[1, 10], [2, 3]]) == [[1, 10]]
ok = ok and m([]) == []
sys.exit(0 if ok else 1)
