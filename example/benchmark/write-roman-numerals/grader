#!/usr/bin/env python3
import os, sys
sys.path.insert(0, os.getcwd())
from roman import to_roman
cases = {1: "I", 4: "IV", 9: "IX", 14: "XIV", 40: "XL", 90: "XC", 400: "CD", 1994: "MCMXCIV", 2026: "MMXXVI", 3999: "MMMCMXCIX"}
if not all(to_roman(k) == v for k, v in cases.items()):
    sys.exit(1)
for bad in (0, 4000, -1):
    try:
        to_roman(bad)
        sys.exit(1)
    except ValueError:
        pass
