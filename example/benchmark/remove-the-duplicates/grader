#!/usr/bin/env python3
import os, sys
sys.path.insert(0, os.getcwd())
from lists import dedupe
ok = dedupe([3, 1, 3, 2, 1]) == [3, 1, 2]
ok = ok and dedupe(["b", "a", "b"]) == ["b", "a"]
ok = ok and dedupe([[1], [2], [1]]) == [[1], [2]]
ok = ok and dedupe([]) == []
src = [1, 1]
ok = ok and dedupe(src) == [1] and src == [1, 1]
sys.exit(0 if ok else 1)
