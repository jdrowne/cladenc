#!/usr/bin/env python3
import subprocess, sys
def want(n):
    return "\n".join("FizzBuzz" if i % 15 == 0 else "Fizz" if i % 3 == 0 else "Buzz" if i % 5 == 0 else str(i) for i in range(1, n + 1))
for n in (1, 15, 31):
    got = subprocess.run([sys.executable, "fizzbuzz.py", str(n)], capture_output=True, text=True, timeout=20).stdout.strip()
    if got != want(n):
        sys.exit(1)
